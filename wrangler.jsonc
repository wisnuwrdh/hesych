{
  // Cloudflare Workers config for the @opennextjs/cloudflare adapter.
  // main/assets point at the `opennextjs-cloudflare build` output — don't change.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hesych",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}